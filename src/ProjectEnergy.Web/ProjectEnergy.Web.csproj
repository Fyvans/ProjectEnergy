<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>project-energy-web</UserSecretsId>
    <!-- Os ficheiros do backoffice Umbraco já vêm pré-comprimidos. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
  </ItemGroup>

  <!-- ICU local para globalização consistente entre plataformas (configuração do template Umbraco 17). -->
  <PropertyGroup>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Os ficheiros Razor são necessários em runtime pelo Umbraco (templates editáveis). -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
    <!-- Ficheiros Node servem apenas a compilação do CSS; não são publicados. -->
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;package-lock.json" />
  </ItemGroup>

  <!--
    Compila Tailwind CSS (Styles/site.css -> wwwroot/css/site.css) antes do build.
    Requer `npm ci` nesta pasta. Para saltar: dotnet build -p:SkipTailwindBuild=true
  -->
  <Target Name="BuildTailwindCss"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipTailwindBuild)' != 'true'"
          Inputs="Styles/site.css;@(Content->WithMetadataValue('Extension','.cshtml'));package-lock.json"
          Outputs="wwwroot/css/site.css">
    <Error Condition="!Exists('node_modules')"
           Text="Dependências Node em falta. Execute 'npm ci' em src/ProjectEnergy.Web antes de compilar." />
    <Exec Command="npm run build:css" />
  </Target>

  <!-- Garante que o CSS gerado entra nos static web assets mesmo no primeiro build. -->
  <Target Name="IncludeTailwindCss" AfterTargets="BuildTailwindCss" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Include="wwwroot/css/site.css" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
