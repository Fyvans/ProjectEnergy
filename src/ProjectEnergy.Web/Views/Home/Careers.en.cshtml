@{
    ViewData["Title"] = "Careers";
    ViewData["Intro"] = "[Demo text] Placeholder for information about working at Project Energy.";
}

<partial name="_PageHeader" />

<section class="container-page grid gap-10 py-14 lg:grid-cols-2">
    <div>
        <h2 class="section-title">Opportunities</h2>
        <div class="demo-note mt-4">
            No openings are published. Real opportunities will only be listed after client
            validation and once the application process is defined.
        </div>
    </div>

    <div class="card">
        <h2 class="section-title">Open application</h2>
        <p class="mt-2 text-sm text-slate-600">
            Visual form only. Submission and CV upload are disabled in this version.
        </p>

        @* No <form>: nothing is submitted or uploaded in this increment. *@
        <fieldset disabled class="mt-6 space-y-4" aria-describedby="careers-disabled">
            <div>
                <label class="form-label" for="careers-name">Name</label>
                <input id="careers-name" type="text" class="form-field" />
            </div>
            <div>
                <label class="form-label" for="careers-email">Email</label>
                <input id="careers-email" type="email" class="form-field" />
            </div>
            <div>
                <label class="form-label" for="careers-area">Area of interest</label>
                <select id="careers-area" class="form-field">
                    <option>[Options to be defined]</option>
                </select>
            </div>
            <div>
                <span class="form-label">CV</span>
                <div class="rounded-md border border-dashed border-slate-300 bg-slate-100 px-3 py-4 text-center text-sm text-slate-500">
                    CV upload unavailable in this version
                </div>
            </div>
            <button type="button" class="btn-disabled">Submit application</button>
        </fieldset>
        <p id="careers-disabled" class="mt-4 text-xs text-slate-500">Demo: this form does not send any data.</p>
    </div>
</section>
