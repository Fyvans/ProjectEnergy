@{
    ViewData["Title"] = "Contact";
    ViewData["Intro"] = "[Demo text] The contact details and form below are not operational.";
}

<partial name="_PageHeader" />

<section class="container-page grid gap-10 py-14 lg:grid-cols-2">
    <div>
        <h2 class="section-title">Contact details</h2>
        <dl class="mt-4 space-y-3 text-sm">
            <div><dt class="font-medium text-slate-700">Address</dt><dd class="text-slate-500">[To be confirmed by the client]</dd></div>
            <div><dt class="font-medium text-slate-700">Phone</dt><dd class="text-slate-500">[To be confirmed by the client]</dd></div>
            <div><dt class="font-medium text-slate-700">Email</dt><dd class="text-slate-500">[To be confirmed by the client]</dd></div>
        </dl>
        <div class="demo-note mt-6">
            No real contact details are shown. Do not use this page to contact the company.
        </div>
    </div>

    <div class="card">
        <h2 class="section-title">Contact / quotation request</h2>
        <p class="mt-2 text-sm text-slate-600">Visual form only. Submission is disabled in this version.</p>

        @* No <form>: nothing is submitted in this increment. *@
        <fieldset disabled class="mt-6 space-y-4" aria-describedby="contact-disabled">
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="form-label" for="contact-name">Name</label>
                    <input id="contact-name" type="text" class="form-field" />
                </div>
                <div>
                    <label class="form-label" for="contact-company">Company</label>
                    <input id="contact-company" type="text" class="form-field" />
                </div>
            </div>
            <div>
                <label class="form-label" for="contact-email">Email</label>
                <input id="contact-email" type="email" class="form-field" />
            </div>
            <div>
                <label class="form-label" for="contact-type">Request type</label>
                <select id="contact-type" class="form-field">
                    <option>General enquiry</option>
                    <option>Request for quotation (RFQ)</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="contact-message">Message</label>
                <textarea id="contact-message" rows="5" class="form-field"></textarea>
            </div>
            <button type="button" class="btn-disabled">Send</button>
        </fieldset>
        <p id="contact-disabled" class="mt-4 text-xs text-slate-500">Demo: this form does not send any data.</p>
    </div>
</section>
