@{
    ViewData["Title"] = "HSEQ";
    ViewData["Heading"] = "HSEQ — Health, Safety, Environment and Quality";
    ViewData["Intro"] = "[Demo text] Structure for presenting HSEQ policies and commitments.";
}

<partial name="_PageHeader" />

<section class="container-page grid gap-6 py-14 md:grid-cols-2">
    @foreach (var area in new[] { "Health", "Safety", "Environment", "Quality" })
    {
        <div class="card">
            <h2 class="font-semibold text-brand-900">@area</h2>
            <p class="mt-2 text-sm text-slate-600">[Example] Policy and commitments to be provided by the client.</p>
        </div>
    }
</section>

<section class="container-page">
    <h2 class="section-title">Certifications</h2>
    <div class="demo-note mt-4">
        No certifications have been confirmed. This section will remain empty until the client
        provides valid certifications and supporting documents.
    </div>
</section>
