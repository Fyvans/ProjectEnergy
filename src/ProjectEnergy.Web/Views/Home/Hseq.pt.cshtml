@{
    ViewData["Title"] = "HSEQ";
    ViewData["Heading"] = "HSEQ — Saúde, Segurança, Ambiente e Qualidade";
    ViewData["Intro"] = "[Texto de demonstração] Estrutura para a apresentação das políticas e compromissos HSEQ.";
}

<partial name="_PageHeader" />

<section class="container-page grid gap-6 py-14 md:grid-cols-2">
    @foreach (var area in new[] { "Saúde", "Segurança", "Ambiente", "Qualidade" })
    {
        <div class="card">
            <h2 class="font-semibold text-brand-900">@area</h2>
            <p class="mt-2 text-sm text-slate-600">[Exemplo] Política e compromissos a fornecer pelo cliente.</p>
        </div>
    }
</section>

<section class="container-page">
    <h2 class="section-title">Certificações</h2>
    <div class="demo-note mt-4">
        Nenhuma certificação foi confirmada. Esta secção ficará vazia até o cliente fornecer
        certificações válidas e respetiva documentação.
    </div>
</section>
