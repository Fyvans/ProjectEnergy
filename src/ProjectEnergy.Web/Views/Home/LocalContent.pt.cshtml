@{
    ViewData["Title"] = "Conteúdo Local";
    ViewData["Intro"] = "[Texto de demonstração] Espaço para descrever o compromisso da empresa com o conteúdo local.";
}

<partial name="_PageHeader" />

<section class="container-page grid gap-6 py-14 md:grid-cols-3">
    @foreach (var topic in new[] { "Emprego e formação", "Fornecedores locais", "Comunidade" })
    {
        <div class="card">
            <h2 class="font-semibold text-brand-900">@topic</h2>
            <p class="mt-2 text-sm text-slate-600">[Exemplo] Texto e indicadores a fornecer pelo cliente. Não são apresentados números.</p>
        </div>
    }
</section>
