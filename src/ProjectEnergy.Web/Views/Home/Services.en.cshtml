@{
    ViewData["Title"] = "Services";
    ViewData["Intro"] = "[Demo text] The services below are placeholders and do not represent Project Energy's actual offering.";
}

<partial name="_PageHeader" />

<section class="container-page py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var letter in new[] { "A", "B", "C", "D", "E", "F" })
        {
            <article class="card">
                <partial name="_DemoBadge" />
                <h2 class="mt-3 font-semibold text-brand-900">Example service @letter</h2>
                <p class="mt-2 text-sm text-slate-600">Demo description. The name, scope and detail of this service will be defined with the client.</p>
            </article>
        }
    </div>
</section>
