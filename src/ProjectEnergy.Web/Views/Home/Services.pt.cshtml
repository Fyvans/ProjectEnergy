@{
    ViewData["Title"] = "Serviços";
    ViewData["Intro"] = "[Texto de demonstração] Os serviços abaixo são marcadores de posição e não representam a oferta real da Project Energy.";
}

<partial name="_PageHeader" />

<section class="container-page py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var letter in new[] { "A", "B", "C", "D", "E", "F" })
        {
            <article class="card">
                <partial name="_DemoBadge" />
                <h2 class="mt-3 font-semibold text-brand-900">Serviço de exemplo @letter</h2>
                <p class="mt-2 text-sm text-slate-600">Descrição de demonstração. O nome, âmbito e detalhe deste serviço serão definidos com o cliente.</p>
            </article>
        }
    </div>
</section>
