@inherits UmbracoViewPage
@{
    var planned = Model.Value<bool>(ContentAliases.Props.IsPlanned);
    string T(string key) => Umbraco.GetDictionaryValue(key) ?? key;
}
<article class="card flex h-full flex-col">
    <div class="flex items-start justify-between gap-3">
        <span class="icon-tile @(planned ? "bg-slate-100 text-slate-500" : "")">@SiteIcons.Svg(Model.Value<string>(ContentAliases.Props.Icon))</span>
        <span class="rounded-full px-2.5 py-0.5 text-[0.7rem] font-semibold tracking-wide uppercase @(planned ? "bg-slate-100 text-slate-600" : "bg-energy-50 text-energy-700")">
            @(planned ? T("Service.Planned") : T("Service.Available"))
        </span>
    </div>
    <h3 class="mt-6 text-lg font-bold">@Model.Name</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">@(Model.Value<string>(ContentAliases.Props.Summary))</p>
</article>
